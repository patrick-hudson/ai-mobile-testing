{
  "name": "quitting7oh-release-audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paired production-versus-candidate release audit for quitting7oh.org.",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "audit": "docker compose --profile audit run --rm audit-release",
    "audit:smoke": "docker compose --profile audit run --rm audit-smoke",
    "audit:release": "docker compose --profile audit run --rm audit-release",
    "audit:release:sharded": "node scripts/run-sharded-release.mjs",
    "audit:candidate": "docker compose --profile audit run --rm audit-release npm run audit:candidate:container",
    "audit:update-visuals": "docker compose --profile audit run --rm audit-update-visuals",
    "audit:lighthouse": "docker compose --profile audit run --rm audit-release npm run audit:lighthouse:container",
    "audit:container": "playwright test",
    "audit:smoke:container": "AUDIT_PROFILE=smoke playwright test tests/smoke.spec.ts tests/contracts.spec.ts",
    "audit:release:container": "AUDIT_PROFILE=release playwright test",
    "audit:release:shard:container": "node scripts/run-playwright-shard.mjs",
    "audit:release:performance:container": "node scripts/run-playwright-performance.mjs",
    "audit:release:merge:container": "node scripts/merge-sharded-release.mjs",
    "audit:candidate:container": "AUDIT_PROFILE=release playwright test --project=candidate-mobile-chromium --project=candidate-desktop-chromium --project=candidate-mobile-webkit --project=candidate-tablet-webkit --project=candidate-desktop-firefox",
    "audit:update-visuals:container": "AUDIT_PROFILE=release playwright test tests/visual-regression.spec.ts --project=candidate-mobile-chromium --project=candidate-desktop-chromium --project=candidate-mobile-webkit --project=candidate-tablet-webkit --project=candidate-desktop-firefox --update-snapshots",
    "audit:lighthouse:container": "AUDIT_PROFILE=release playwright test tests/performance.spec.ts --project=production-mobile-chromium --project=candidate-mobile-chromium --project=candidate-desktop-chromium",
    "audit:docker-smoke": "docker compose run --rm audit-smoke",
    "audit:docker-release": "docker compose run --rm audit-release",
    "audit:docker-release:sharded": "node scripts/run-sharded-release.mjs",
    "portal": "docker compose up --build portal",
    "portal:container": "node portal/server.mjs",
    "portal:e2e": "docker compose --profile portal-test build portal-e2e && docker compose --profile portal-test run --rm portal-e2e",
    "portal:e2e:scale": "docker compose --profile portal-test build portal-e2e && docker compose --profile portal-test run --rm -e PORTAL_E2E_GREP=canonical.reference-scale portal-e2e",
    "portal:e2e:container": "node scripts/run-portal-e2e.mjs",
    "media:process": "tsx scripts/process-videos.ts",
    "report:rebuild": "tsx scripts/rebuild-report.ts",
    "ai:review": "tsx scripts/analyze-run.ts",
    "ai:self-test": "tsx scripts/analyze-run.ts --self-test",
    "release-truth:self-test": "node scripts/release-truth-self-test.mjs",
    "report-audit-id:self-test": "node --import tsx scripts/report-audit-id-self-test.ts",
    "report-poster:self-test": "node --import tsx scripts/report-poster-self-test.ts",
    "gallery-catalog:self-test": "node --import tsx scripts/gallery-catalog-self-test.ts",
    "gallery-archive:self-test": "node scripts/gallery-archive-self-test.mjs",
    "gallery-scale:self-test": "node --import tsx scripts/gallery-scale-self-test.ts",
    "gallery-retention:self-test": "node scripts/gallery-retention-self-test.mjs",
    "gallery-flags:self-test": "node --import tsx scripts/gallery-flags-self-test.ts",
    "gallery-state:self-test": "node scripts/gallery-state-self-test.mjs",
    "portal-e2e-output:self-test": "node scripts/portal-e2e-output-self-test.mjs",
    "portal-security:self-test": "node scripts/portal-security-self-test.mjs",
    "evidence-policy:self-test": "node --import tsx scripts/evidence-policy-self-test.ts",
    "video-retention:self-test": "node --import tsx scripts/video-retention-self-test.ts",
    "sharded-isolation:self-test": "node scripts/sharded-isolation-self-test.mjs",
    "plugins:validate": "node --import tsx scripts/validate-plugins.ts",
    "plugins:check": "node --import tsx scripts/validate-plugins.ts --check",
    "plugins:metadata-self-test": "node --import tsx scripts/validate-plugin-metadata.ts",
    "tls:check": "node --import tsx scripts/validate-tls-policy.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run plugins:check && npm run plugins:metadata-self-test && npm run evidence-policy:self-test && npm run video-retention:self-test && npm run release-truth:self-test && npm run report-audit-id:self-test && npm run report-poster:self-test && npm run gallery-catalog:self-test && npm run gallery-archive:self-test && npm run gallery-scale:self-test && npm run gallery-retention:self-test && npm run gallery-flags:self-test && npm run gallery-state:self-test && npm run portal-e2e-output:self-test && npm run portal-security:self-test && npm run sharded-isolation:self-test && npm run typecheck && npm run tls:check",
    "test": "npm run validate && npm run audit:smoke"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "lighthouse": "13.4.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  }
}
