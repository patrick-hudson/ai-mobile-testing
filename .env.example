# Public targets may be overridden for a staging deployment.
PRODUCTION_URL=https://quitting7oh.org
CANDIDATE_URL=https://beta.quitting7oh-org.pages.dev

PORTAL_PORT=4173
PORTAL_SHARDED_ARTIFACT_ROOT=/work/artifacts/sharded
PORTAL_EXTERNAL_RUN_SYNC_MS=1000
AUDIT_WORKERS=3
AUDIT_VERBOSE=1
CANDIDATE_IGNORE_HTTPS_ERRORS=0

# Optional environment-managed advisory review. The portal can instead save an
# encrypted key in its Docker secret volume. Never commit a real value here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_REVIEW_DRY_RUN=0
