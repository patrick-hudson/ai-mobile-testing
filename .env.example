# Public targets may be overridden for a staging deployment.
PRODUCTION_URL=https://quitting7oh.org
CANDIDATE_URL=https://beta.quitting7oh-org.pages.dev

PORTAL_PORT=4173
PORTAL_SHARDED_ARTIFACT_ROOT=/work/artifacts/sharded
PORTAL_EXTERNAL_RUN_SYNC_MS=1000
AUDIT_WORKERS=3
AUDIT_VERBOSE=1
AUDIT_TARGET_IDS=
INSTALL_MSEDGE=0
# Add browser:msedge only when INSTALL_MSEDGE=1 builds the branded browser into the image.
AUDIT_SHARED_ORDINARY_CAPABILITIES=inventory:http,browser:chromium,browser:firefox,browser:webkit
# Must remain 0. Browser-level bypass cannot be constrained to one origin.
CANDIDATE_IGNORE_HTTPS_ERRORS=0

# Save the advisory-review key in the portal. Compose deliberately does not
# forward ANTHROPIC_API_KEY because container configuration is inspectable.
ANTHROPIC_MODEL=claude-sonnet-5
AI_REVIEW_DRY_RUN=0
# Exact HTTPS origins approved for non-authoritative Single-site Preview certificate bypass.
# Comparative runs and Production-role Single-site runs always enforce certificates.
AUDIT_PREVIEW_TLS_BYPASS_ALLOWLIST=https://beta.quitting7oh-org.pages.dev
